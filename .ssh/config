Host github.com
    Hostname ssh.github.com
    Port 443
    User git

Host z
    Hostname z
    User alireza
    AddressFamily inet6
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h:%p
    VerifyHostKeyDNS no

Host i7
    Hostname i7
    User alireza
    AddressFamily inet6
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h:%p
    VerifyHostKeyDNS no

Host ec2svr
    Hostname alireza.me
    User root
    AddressFamily inet6
    ControlMaster auto
    ControlPersist yes
    ControlPath ~/.ssh/cm-%r@%h:%p

Host *
    VisualHostKey yes
    VerifyHostKeyDNS yes
